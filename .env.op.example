# 1Password Integration Configuration
# Copy this file to .env.op and fill in your vault details

# Vault Configuration
OP_VAULT=production
OP_ACCOUNT=default

# 1Password Connect (optional - for service accounts)
OP_CONNECT_HOST=localhost:8080
OP_CONNECT_TOKEN=

# CLI Timeout (seconds)
OP_TIMEOUT=5

# Database Secrets References
DATABASE_URL_REF=op://production/Database/connection-string
DATABASE_PASSWORD_REF=op://production/Database/password
DATABASE_USER_REF=op://production/Database/username
DATABASE_HOST_REF=op://production/Database/host
DATABASE_PORT_REF=op://production/Database/port

# API Keys and Tokens
GITHUB_TOKEN_REF=op://production/GitHub/token
GITHUB_USER_REF=op://production/GitHub/username
API_KEY_REF=op://production/API/key
API_SECRET_REF=op://production/API/secret

# Authentication
JWT_SECRET_REF=op://production/Auth/jwt-secret
SESSION_SECRET_REF=op://production/Auth/session-secret
ENCRYPTION_KEY_REF=op://production/Auth/encryption-key

# Third-party Services
STRIPE_API_KEY_REF=op://production/Stripe/api-key
STRIPE_WEBHOOK_SECRET_REF=op://production/Stripe/webhook-secret

# Tailscale Configuration
TAILSCALE_AUTH_KEY_REF=op://production/Tailscale/auth-key
TAILSCALE_API_KEY_REF=op://production/Tailscale/api-key
TAILSCALE_CONTROL_SERVER_REF=op://production/Tailscale/control-server

# Monitoring and Logging
SENTRY_DSN_REF=op://production/Monitoring/sentry-dsn
DATADOG_API_KEY_REF=op://production/Monitoring/datadog-api-key

# SSH and SSH Keys
SSH_PRIVATE_KEY_REF=op://production/SSH/private-key
SSH_PUBLIC_KEY_REF=op://production/SSH/public-key

# Development Environment (override for dev vault if needed)
# DEV_OP_VAULT=development
# DEV_DATABASE_URL_REF=op://development/Database/connection-string
